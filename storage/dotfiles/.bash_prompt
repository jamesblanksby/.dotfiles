#!/usr/bin/env bash

RESET="\[\e[0m\]"

BLUE="\[\e[1;34m\]"
CYAN="\[\e[1;36m\]"
GOLD="\[\e[1;33m\]"
RUBY="\[\e[1;31m\]"

function ps1_git() {
    git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'
}

PS1=""

if [[ "${USER}" == "root" ]]; then
    PS1+="${RUBY}\u${RESET}"
fi

if [[ "${SSH_TTY}" ]]; then
    if [[ "${USER}" == "root" ]]; then
        PS1+="${RUBY}@${RESET}"
    fi
    PS1+="${RUBY}\h${RESET}"
fi

PS1+="[${BLUE}\W${RESET}]"

if git status > /dev/null 2>&1; then
    PS1+="(${CYAN}\$(ps1_git)${RESET})"
fi

PS1+="${GOLD}\$${RESET} "
